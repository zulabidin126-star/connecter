[Unit]
Description=LokSync GUI tray
After=lok-sync.service graphical-session.target
PartOf=graphical-session.target
Requires=lok-sync.service

[Service]
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:%h/.nix-profile/bin:/run/current-system/sw/bin"
ExecStart=%h/.local/bin/lok-sync-gui
Slice=lok-sync.slice
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
