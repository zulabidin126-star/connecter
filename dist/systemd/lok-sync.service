[Unit]
Description=LokSync daemon (local phone <-> Linux bridge)
Documentation=https://github.com/loksync/loksync
After=network-online.target dbus.socket
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:%h/.nix-profile/bin:/run/current-system/sw/bin"
ExecStart=%h/.local/bin/lok-sync-d
ExecReload=/bin/kill -HUP $MAINPID

# Automatically ensure runtime and state directories exist
RuntimeDirectory=lok-sync
StateDirectory=lok-sync

# --- Self-healing ---
Restart=on-failure
RestartSec=2

# --- Resource throttling ---
Slice=lok-sync.slice
MemoryHigh=20M
MemoryMax=25M
MemorySwapMax=0
CPUQuota=10%
TasksMax=32
LimitNOFILE=256
Nice=10

# --- Hardening compatible with systemd user session ---
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=default.target
